// use prisma-next

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  passwordHash String
  name         String?
  role         String            @default("USER")
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @updatedAt

  farms        Farm[]
}

model Farm {
  id        Int               @id @default(autoincrement())
  userId    Int
  name      String
  location  String
  cropType  String
  area      Float
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @updatedAt

  user      User              @relation(fields: [userId], references: [id])
}