// use prisma-next

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  passwordHash String
  name         String?
  role         String             @default("USER")
  createdAt    TimestamptzString  @default(now())
  updatedAt    temporal.updatedAtString()
}

// model farm will come here

model Scan {
  id          Int               @id @default(autoincrement())
  farmId      Int
  imageUrl    String
  status      String            @default("PENDING")
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}