# ─────────────────────────────────────────────────────────────
# AgriBharat Backend — Environment Variables
# Copy this file to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (requires PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Frontend origin (used for CORS allow-list)
FRONTEND_URL="http://localhost:3000"

# JWT signing secret — MUST be at least 32 characters
JWT_SECRET="your-super-secret-jwt-key-minimum-32chars"
JWT_EXPIRES_IN="7d"

# Backend Express server port
PORT=5000

# ─────────────────────────────────────────────────────────────
# Python Microservices
# ─────────────────────────────────────────────────────────────

# Python FastAPI ML disease-detection service (crop-disease/main.py)
# Run: cd crop-disease && uvicorn main:app --host 0.0.0.0 --port 8000
ML_SERVICE_URL="http://localhost:8000"

# Python Gemini FAQ chatbot service (crop-disease/faq_bot.py)
# Run: cd crop-disease && uvicorn faq_bot:app --host 0.0.0.0 --port 8001
CHATBOT_SERVICE_URL="http://localhost:8001"

# ───────────────────────────────────────────────────────────────
# Twilio WhatsApp Webhook (optional — set to activate live WhatsApp bot)
# 1. Create a free Twilio account: https://www.twilio.com/try-twilio
# 2. Go to: Console → Messaging → Try it out → Send a WhatsApp message
# 3. Expose backend with ngrok: ngrok http 5000
# 4. Set webhook URL in Twilio Console to:
#    https://<ngrok-id>.ngrok.io/api/v1/whatsapp/webhook
# ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
# Twilio sandbox default sender — replace with your approved number in production
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
